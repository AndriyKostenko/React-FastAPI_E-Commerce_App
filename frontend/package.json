{
  "name": "e-commerce_app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "gen:api": "node scripts/generate-api-types.mjs",
    "test:session": "node --test --test-concurrency=1 tests/session-isolation.test.mjs",
    "seed:session-users": "node tests/seed-session-users.mjs",
    "test:race": "node --import tsx --test tests/session-race.test.ts",
    "test:unit": "node --import tsx --test tests/variant-matrix.test.ts tests/auth-error-link.test.ts tests/env-schema.test.ts tests/shop-card.test.ts",
    "test:cart-pricing": "node --test --test-concurrency=1 tests/cart-pricing.test.mjs",
    "test:session-refresh": "node --import tsx --test --test-concurrency=1 tests/session-refresh.test.ts",
    "test:components": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report e2e/.report"
  },
  "dependencies": {
    "@marsidev/react-turnstile": "1.6.2",
    "@stripe/react-stripe-js": "^6.3.0",
    "@stripe/stripe-js": "^9.4.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "next": "^16.4.2",
    "next-auth": "^4.24.15",
    "query-string": "^9.5.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.90.0",
    "react-hot-toast": "^2.6.1",
    "react-icons": "^4.12.0",
    "sharp": "^0.35.3",
    "stripe": "^15.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.2",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8",
    "tailwindcss": "^3.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
