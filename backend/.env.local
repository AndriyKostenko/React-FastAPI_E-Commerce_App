# ---------------------------------------------------------------------------
# Local, no-Docker overrides.  Copy to backend/.env.local.
#
# shared/settings.py loads (.env, .env.local) in that order, so every value
# here wins over .env.  Real environment variables still win over both, and
# docker-compose injects POSTGRES_HOST/DATABASE_URL/... as real variables --
# which is why this file does not disturb the Docker setup at all.
# ---------------------------------------------------------------------------

DEBUG_MODE=True
APP_HOST=127.0.0.1

# --- Infra now runs natively on this machine, not on the compose network ----
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Native redis listens on 6379 (compose publishes its container on 6380).
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672

# --- Service-to-service URLs -----------------------------------------------
# Container DNS names ("http://user-service:8001") do not resolve off-Docker.
API_GATEWAY_SERVICE_URL=http://127.0.0.1:8000
USER_SERVICE_URL=http://127.0.0.1:8001
PRODUCT_SERVICE_URL=http://127.0.0.1:8002
NOTIFICATION_SERVICE_URL=http://127.0.0.1:8003
NOTIFICATION_CONSUMER_SERVICE_URL=http://127.0.0.1:8004
ORDER_SERVICE_URL=http://127.0.0.1:8005
PAYMENT_SERVICE_URL=http://127.0.0.1:8006
CART_SERVICE_URL=http://127.0.0.1:8007
SHIPPING_SERVICE_URL=http://127.0.0.1:8008
WISHLIST_SERVICE_URL=http://127.0.0.1:8009
SUPPLIER_SERVICE_URL=http://127.0.0.1:8010

# --- Observability stack is intentionally not running locally ---------------
# OTEL_TRACES_DISABLED / PROMETHEUS_MULTIPROC_DIR are read from the real
# environment (os.getenv), not from this file -- local/dev.sh exports them.

# --- Product media ----------------------------------------------------------
# MEDIA_ROOT is exported by local/dev.sh (backend/local/data/media). It is not
# set here because this file is tracked in git and the path is machine-specific;
# a service started by hand falls back to .env's ./media.

CJ_DROPSHIPPING_USE_DEFAULT_CATEGORY=true
CJ_DROPSHIPPING_DEFAULT_CATEGORY_NAME=t-shirts
